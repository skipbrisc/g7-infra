if [[ ${1:-} == --ssh ]]; then
  read -r -a argv <<< "${SSH_ORIGINAL_COMMAND:-help}"
  [[ ${argv[0]:-} == g7-agent ]] && argv=("${argv[@]:1}")
  set -- "${argv[@]}"
  [[ ${1:-} == _* ]] && die "unknown command $1 (g7-agent help)"
fi
cmd=${1:-help}; shift || true
case $cmd in
  help|-h|--help) cmd_help ;;
  repos) cmd_repos ;;
  start) cmd_start "$@" ;;
  resume) cmd_resume "$@" ;;
  list|ls) cmd_list ;;
  status) cmd_status "$@" ;;
  logs|log) cmd_logs "$@" ;;
  result) cmd_result "$@" ;;
  wait) cmd_wait "$@" ;;
  stop) cmd_stop "$@" ;;
  attach) cmd_attach "${1:-}" ;;
  watch) cmd_attach "${1:-}" readonly ;;
  clean) cmd_clean "$@" ;;
  mem) cmd_mem ;;
  doctor) cmd_doctor ;;
  set-token) store_token "$CONF/oauth-token" '^sk-ant-[A-Za-z0-9_-]{20,}$' "Claude token from claude setup-token" ;;
  set-ntfy-token) store_token "$CONF/ntfy-token" '^tk_[A-Za-z0-9]{20,}$' "ntfy token" ;;
  _run) cmd__run "$@" ;;
  _selftest) cmd__selftest ;;
  *) die "unknown command $cmd (g7-agent help)" ;;
esac
