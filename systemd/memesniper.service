[Unit]
Description=MemeSniper paper monitor dashboard
Wants=network-online.target
Requires=wg-quick@wg0.service
After=network-online.target wg-quick@wg0.service

[Service]
Type=simple
User=memesniper
Group=memesniper
WorkingDirectory=/var/lib/memesniper
UMask=0077
ExecStart=/opt/memesniper/venv/bin/python -m memesniper serve --host 10.77.0.1 --port 8765 --monitor-only --db /var/lib/memesniper/g7-monitor.sqlite --token-file /var/lib/memesniper/secrets/control-token.txt
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
