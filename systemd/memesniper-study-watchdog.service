[Unit]
Description=MemeSniper study liveness pings (independent observer)

[Service]
Type=oneshot
User=memesniper
Group=memesniper
SupplementaryGroups=memesniper-tier2
ExecStart=/usr/bin/python3 -I -S -B /opt/memesniper-study-watchdog/study_watchdog.py
StateDirectory=memesniper-study-watchdog
StateDirectoryMode=0750
UMask=0077
TimeoutStartSec=150
Nice=19
CPUWeight=1
IOWeight=1
MemoryMax=64M
TasksMax=16
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/var/lib/memesniper /var/lib/memesniper-tier2-20261110
ReadWritePaths=/var/lib/memesniper-study-watchdog
InaccessiblePaths=-/var/lib/memesniper-signer -/etc/memesniper-live
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=null
