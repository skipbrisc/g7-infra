#!/bin/sh
# /usr/local/sbin/skipos-backup on Miami (root:root 0755). Source: mia/skipos in g7-infra.
# Nightly copy of what a SkipOS rebuild would need, into /srv/skipos-backups/<date>/ :
#   - a full logical dump of the database (pg_dumpall)
#   - the small volumes that cannot be regenerated consistently with it:
#     root-escrow, dbcreds, db-certs, certs
#   - infra/docker/.env and the checked-out commit
# Keeps 14 days.
#
#
# Off the server: when 08-offsite.sh has been run, each night's folder is also added to an
# encrypted restic repository behind this server's append-only REST server
# (rest:http://10.78.0.1:8000/skipos/restic), and G7 copies that repository to its own backup
# disk every night (g7/skipos-backup in g7-infra). Without 08-offsite.sh the backup is on this
# disk only, which covers a bad change or a wiped volume but not losing the server.
#
# The dated folders are unencrypted and include the stack's secrets. They are root-only, on a
# disk that already holds the same secrets live. Check a backup with skipos-restore-drill.
set -eu
[ "$(id -u)" = 0 ] || { echo "run with sudo" >&2; exit 1; }
DIR=/opt/skipos
COMPOSE="docker compose -f $DIR/infra/docker/docker-compose.yml"
ROOT=/srv/skipos-backups
OUT=$ROOT/$(date -u +%Y%m%dT%H%M%SZ)
umask 077
install -d -m 0700 -o root -g root "$ROOT" "$OUT"

# The database, over the container's local socket (no password, no TLS needed there).
$COMPOSE exec -T postgres pg_dumpall -U postgres | gzip > "$OUT/pg_dumpall.sql.gz"
gzip -t "$OUT/pg_dumpall.sql.gz"
[ "$(stat -c %s "$OUT/pg_dumpall.sql.gz")" -gt 10000 ] || { echo "the dump is suspiciously small" >&2; exit 1; }

for v in root-escrow dbcreds db-certs certs; do
  # The database image is already on the server and has tar; nothing is pulled.
  docker run --rm --network none -v "skipos_$v:/v:ro" -v "$OUT:/out" --entrypoint tar pgvector/pgvector:pg17 \
    -czf "/out/volume-$v.tgz" -C /v .
done

install -m 0600 "$DIR/infra/docker/.env" "$OUT/env"
# As the checkout's owner: root's git refuses a repository owned by someone else.
# shellcheck disable=SC2024  # the file is written by root on purpose; only git runs as skipos
sudo -u skipos git -C "$DIR" rev-parse HEAD > "$OUT/commit" 2>/dev/null || true

# The encrypted, off-server-bound copy (08-offsite.sh). A failure here fails the run: a night
# with no off-server copy must not look like a good backup.
if [ -r /etc/skipos/restic-rest-env ] && [ -r /etc/skipos/restic-repo-pass ]; then
  set -a
  # shellcheck source=/dev/null
  . /etc/skipos/restic-rest-env
  set +a
  RESTIC_CACHE_DIR=/var/cache/restic-skipos restic -r rest:http://10.78.0.1:8000/skipos/restic \
    --password-file /etc/skipos/restic-repo-pass backup "$OUT" --tag skipos --host mia --quiet \
    || { echo "skipos-backup: the restic copy failed" >&2; exit 1; }
  echo "skipos-backup: added to the restic repository"
fi

# Keep the newest 14.
find "$ROOT" -mindepth 1 -maxdepth 1 -type d -name '20*' | sort | head -n -14 | while read -r old; do rm -rf "$old"; done

du -sh "$OUT" | awk '{print "skipos-backup: " $2 " (" $1 ")"}'
URL=""
[ -r /etc/skipos/hc-backup-url ] && URL=$(tr -d '[:space:]' < /etc/skipos/hc-backup-url)
[ -n "$URL" ] && curl -fsS -m 10 --retry 3 -o /dev/null "$URL" || true
