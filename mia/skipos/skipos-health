#!/bin/sh
# /usr/local/sbin/skipos-health on Miami (root:root 0755). Source: mia/skipos in g7-infra.
# Run every 5 minutes from root's crontab. Works out whether the SkipOS stack is healthy:
# every long-running service is "running", the console answers, and last night's backup
# exists. It prints one line, "skipos ok" or "skipos DOWN: <what>", and writes the same line
# to /var/lib/skipos-status/index.txt, which G7's Uptime Kuma reads over the link
# (07-status.sh). If a Healthchecks.io ping address is in /etc/skipos/hc-ping-url it pings
# that too; that part is optional. Never exits non-zero, so cron stays quiet.
DIR=/opt/skipos
COMPOSE="docker compose -f $DIR/infra/docker/docker-compose.yml"
WANT="postgres redis redis-agent auth pdp temporal memory embedder api orchestrator worker-node gateway-realtime admin admin-bearers"
# worker-claude exits with code 0 by design until it is armed, so it is expected to be
# running only when CLAUDE_AGENT_LIVE=1 is set in the stack's .env.
grep -q '^CLAUDE_AGENT_LIVE=1' "$DIR/infra/docker/.env" 2>/dev/null && WANT="$WANT worker-claude"

RUNNING=$($COMPOSE ps --status running --services 2>/dev/null || true)
DOWN=""
for s in $WANT; do
  echo "$RUNNING" | grep -qx "$s" || DOWN="$DOWN $s"
done
CODE=$(curl -s -m 10 -o /dev/null -w '%{http_code}' http://127.0.0.1:3000/ 2>/dev/null || true)
[ "$CODE" = 200 ] || DOWN="$DOWN console-http-$CODE"

# The nightly backup: stale when the newest one is more than 30 hours old. Not checked
# until a first backup exists, so a new install is not "down" before its first night.
BACKUPS=/srv/skipos-backups
if [ -n "$(find "$BACKUPS" -mindepth 1 -maxdepth 1 -type d -name '20*' 2>/dev/null | head -n 1)" ]; then
  [ -n "$(find "$BACKUPS" -mindepth 1 -maxdepth 1 -type d -name '20*' -mmin -1800 2>/dev/null | head -n 1)" ] \
    || DOWN="$DOWN backup-stale"
fi

if [ -z "$DOWN" ]; then LINE="skipos ok"; else LINE="skipos DOWN:$DOWN"; fi
echo "$LINE"

# The status page G7's Uptime Kuma reads (07-status.sh serves this folder on the link to G7).
# Written whole, then renamed, so a reader never sees half a file.
STATUS_DIR=/var/lib/skipos-status
if [ -d "$STATUS_DIR" ]; then
  printf '%s\nchecked %s\n' "$LINE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATUS_DIR/index.txt.new"
  chmod 0644 "$STATUS_DIR/index.txt.new"
  mv "$STATUS_DIR/index.txt.new" "$STATUS_DIR/index.txt"
fi

# Optional: a Healthchecks.io check, if its ping address was stored.
URL=""
[ -r /etc/skipos/hc-ping-url ] && URL=$(tr -d '[:space:]' < /etc/skipos/hc-ping-url)
if [ -n "$URL" ]; then
  if [ -z "$DOWN" ]; then curl -fsS -m 10 --retry 3 -o /dev/null "$URL" || true
  else curl -fsS -m 10 --retry 3 -o /dev/null --data-raw "down:$DOWN" "$URL/fail" || true; fi
fi
exit 0
