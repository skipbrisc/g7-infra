# /etc/systemd/system/skipos-backup.timer on Miami. Source: mia/skipos in g7-infra.
# 02:10, clear of G7's nightly copy to this server at about 03:20.
[Unit]
Description=SkipOS nightly backup

[Timer]
OnCalendar=*-*-* 02:10:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
