#!/bin/sh
# /usr/local/sbin/g7-image-scan on G7 (root:root 0700). Source: g7/image-scan in the g7-infra repo.
# Scans the image of every running container for known vulnerabilities that have a fix, and
# alerts when any is high or critical. Report only: it changes no container and blocks no deploy.
# Run by g7-image-scan.timer; by hand: sudo systemctl start g7-image-scan.service
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
WORK=/var/cache/imgscan
LOG=/var/log/g7-image-scan.txt
NTFY_TOKEN_FILE=/root/.ntfy-g7-token

notify() { # title, message, priority
  [ -r "$NTFY_TOKEN_FILE" ] || return 0
  curl -fsS -m 10 -o /dev/null -H "Authorization: Bearer $(tr -d '[:space:]' < "$NTFY_TOKEN_FILE")" \
    -H "Title: $1" -H "Priority: $3" -d "$2" http://127.0.0.1:2586/g7 || true
}

umask 077
TAR=$WORK/tmp/image.tar; JSON=$WORK/tmp/report.json; ERR=$WORK/tmp/scan-error.txt
: > "$LOG.new"
echo "G7 image scan, $(date '+%Y-%m-%d %H:%M %Z'). Fixable high and critical findings only, one line per package." >> "$LOG.new"
flagged=""; failed=""; count=0

for img in $(docker ps --format '{{.Image}}' | sort -u); do
  count=$((count + 1))
  # A container started before its image was rebuilt shows a bare image ID here, not a name.
  # Name the container in every message so the report says what to recreate.
  label=$img
  case "$img" in
    *[!0-9a-f]*) : ;;
    *) label="$img (untagged; container $(docker ps --filter "ancestor=$img" --format '{{.Names}}' | tr '\n' ' ' | sed 's/ $//'); recreate it to run its rebuilt image)" ;;
  esac
  rm -f "$TAR" "$JSON" "$ERR"
  install -o imgscan -g imgscan -m 0600 /dev/null "$ERR"
  if ! docker save "$img" -o "$TAR" 2>"$ERR"; then
    echo "g7-image-scan: docker save $img failed: $(tail -n 2 "$ERR" | tr '\n' ' ' | cut -c1-300)" >&2
    failed="$failed [$label]"; continue
  fi
  chown imgscan:imgscan "$TAR"
  # As the unprivileged scan user: no Docker access, no secrets, only this one file.
  # An image built with provenance attestations is exported in OCI layout, so try that reader
  # second. On failure the scanner's last lines go to the journal, since they say why.
  ok=""
  for kind in docker-archive oci-archive; do
    if runuser -u imgscan -- env HOME="$WORK" GRYPE_DB_CACHE_DIR="$WORK/db" GRYPE_CHECK_FOR_APP_UPDATE=false \
         /usr/local/bin/grype "$kind:$TAR" --only-fixed -o json --file "$JSON" -q 2>"$ERR"; then ok=1; break; fi
    echo "g7-image-scan: $img as $kind failed: $(tail -n 3 "$ERR" 2>/dev/null | tr '\n' ' ' | cut -c1-400)" >&2
  done
  if [ -z "$ok" ]; then failed="$failed [$label]"; rm -f "$TAR"; continue; fi
  rm -f "$TAR"
  n=$(python3 - "$JSON" "$img" "$LOG.new" <<'PY'
import json, sys
path, image, log = sys.argv[1:4]
try:
    matches = json.load(open(path)).get("matches", [])
except Exception:
    print("error"); sys.exit(0)
seen = set(); groups = {}
for m in matches:
    v = m.get("vulnerability", {}); a = m.get("artifact", {})
    sev = str(v.get("severity", "")).lower()
    if sev not in ("high", "critical"):
        continue
    key = (str(a.get("name")), str(a.get("version")), str(v.get("id")))
    if key in seen:
        continue
    seen.add(key)
    g = groups.setdefault(key[:2], {"critical": 0, "high": 0, "fixes": set()})
    g[sev] += 1
    g["fixes"].update((v.get("fix") or {}).get("versions") or [])
rows = seen
# One line per package, worst first: the remedy is per package (a newer image), not per CVE.
order = sorted(groups.items(), key=lambda kv: (-kv[1]["critical"], -kv[1]["high"], kv[0]))
with open(log, "a") as out:
    out.write("\n%s: %d findings in %d packages\n" % (image, len(rows), len(groups)))
    for (name, ver), g in order:
        counts = ", ".join("%d %s" % (g[k], k) for k in ("critical", "high") if g[k])
        fixes = sorted(g["fixes"])
        fix = fixes[-1] if fixes else "see advisory"
        if len(fixes) > 1:
            fix += " (or another of %d fixed versions)" % len(fixes)
        out.write("  %-28s %-34s %-22s fixed in %s\n" % (name[:28], ver[:34], counts, fix))
print(len(rows))
PY
)
  case "$n" in
    error) failed="$failed [$label]" ;;
    0) : ;;
    *) flagged="$flagged $img($n)" ;;
  esac
done
rm -f "$TAR" "$JSON" "$ERR"
mv "$LOG.new" "$LOG"; chmod 600 "$LOG"

if [ -n "$failed" ]; then
  notify "G7 image scan incomplete" "Could not scan:$failed. Details: sudo journalctl -u g7-image-scan -n 30" high
  echo "g7-image-scan: could not scan:$failed" >&2
fi
if [ -n "$flagged" ]; then
  notify "G7 images need updating" "Fixable high or critical vulnerabilities in:$flagged. Report: sudo cat $LOG" high
  echo "g7-image-scan: findings in:$flagged (see $LOG)"
elif [ -z "$failed" ]; then
  notify "G7 image scan ok" "$count images scanned, no fixable high or critical vulnerabilities." low
  echo "g7-image-scan: $count images clean"
fi
[ -z "$failed" ]
