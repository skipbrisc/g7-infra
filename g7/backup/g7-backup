#!/bin/sh
# /usr/local/sbin/g7-backup on G7 (root:root 0700). Source: g7/backup/g7-backup in the g7-infra repo.
# Nightly encrypted, deduplicated backup of G7's own state into a restic repository on the second
# disk, then a copy of the snapshots to the off-site repository on the Miami server (over the
# wg-mia tunnel, as g7backup; root's ~/.ssh/config has the mia-backup host).
# Run by g7-backup.timer; run by hand with: sudo /usr/local/sbin/g7-backup
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export RESTIC_REPOSITORY=/mnt/data/G7-backups/restic
export RESTIC_PASSWORD_FILE=/root/.restic-g7
export RESTIC_CACHE_DIR=/var/cache/restic   # systemd runs this without $HOME
OFFSITE=sftp:mia-backup:/srv/backups/g7/restic
STAGE=/var/backups/g7-stage
NTFY_TOKEN_FILE=/root/.ntfy-g7-token

notify() { # title, message, priority
  [ -r "$NTFY_TOKEN_FILE" ] || return 0
  curl -fsS -m 10 -o /dev/null -H "Authorization: Bearer $(tr -d '[:space:]' < "$NTFY_TOKEN_FILE")" \
    -H "Title: $1" -H "Priority: $3" -d "$2" http://127.0.0.1:2586/g7 || true
}
fail() { notify "G7 backup FAILED" "$1" high; echo "g7-backup: $1" >&2; exit 1; }

mountpoint -q /mnt/data || mount /mnt/data || fail "the backup disk (/mnt/data) is not mounted"
[ -d "$RESTIC_REPOSITORY" ] || fail "no restic repository at $RESTIC_REPOSITORY"

# Consistent copies of the databases that are written while running.
rm -rf "$STAGE"; mkdir -p -m 0700 "$STAGE"
if [ -f /srv/vaultwarden/data/db.sqlite3 ]; then
  sqlite3 /srv/vaultwarden/data/db.sqlite3 ".backup '$STAGE/vaultwarden-db.sqlite3'" || fail "Vaultwarden database copy failed"
fi
if [ -f /opt/ntfy/lib/user.db ]; then
  sqlite3 /opt/ntfy/lib/user.db ".backup '$STAGE/ntfy-user.db'" || fail "ntfy user database copy failed"
fi
if [ -f /opt/uptime-kuma/data/kuma.db ]; then
  sqlite3 /opt/uptime-kuma/data/kuma.db ".backup '$STAGE/uptime-kuma.db'" || echo "g7-backup: Uptime Kuma database copy skipped (monitor settings only; not fatal)" >&2
fi

# What a rebuild needs to know was installed.
dpkg --get-selections > "$STAGE/dpkg-selections.txt" 2>/dev/null || true
apt-mark showmanual > "$STAGE/apt-manual.txt" 2>/dev/null || true

# /srv/media-masters holds raw footage and promotions work copied up from the PC
# (guatemalahope.org: scripts/backup-raw-media.ps1). It is not in Git anywhere.
# Everything a rebuild needs. Paths that do not exist on this machine are skipped, and the
# memesniper globs pick up new install and state folders without editing this file.
PATHS=""
for p in "$STAGE" /srv/git /srv/vaultwarden /var/lib/jenkins /var/lib/jenkins-agent \
         /opt/taxglasses /opt/ntfy /opt/uptime-kuma /opt/memesniper* /var/lib/memesniper* \
         /root /home/buttmud /etc /usr/local/sbin /var/backups/jenkins \
         /var/spool/cron/crontabs /var/lib/docker/volumes \
         /srv/media-masters \
         /var/lib/bitcoind /var/lib/bitcoin; do
  [ -e "$p" ] && PATHS="$PATHS $p"
done

# shellcheck disable=SC2086  # PATHS is a space-separated list of paths without spaces
restic backup --one-file-system --tag nightly \
  --exclude /var/lib/memesniper/incoming \
  --exclude /var/lib/memesniper/imports \
  --exclude /var/lib/memesniper/.npm \
  --exclude /var/lib/memesniper/migration-tools \
  --exclude /var/lib/jenkins/workspace \
  --exclude /var/lib/jenkins/caches \
  --exclude /var/lib/jenkins/.cache \
  --exclude /var/lib/jenkins-agent/workspace \
  --exclude /var/lib/jenkins-agent/caches \
  --exclude /var/lib/jenkins-agent/.cache \
  --exclude /var/lib/jenkins-agent/.npm \
  --exclude /root/.cache \
  --exclude /home/buttmud/.cache \
  --exclude .bitcoin/blocks --exclude .bitcoin/chainstate --exclude .bitcoin/indexes \
  --exclude /var/lib/bitcoind/blocks --exclude /var/lib/bitcoind/chainstate --exclude /var/lib/bitcoind/indexes \
  --exclude /var/lib/bitcoin/blocks --exclude /var/lib/bitcoin/chainstate --exclude /var/lib/bitcoin/indexes \
  --exclude '*.sqlite-shm' \
  $PATHS \
  || fail "restic backup failed (exit $?)"

restic forget --keep-daily 14 --keep-weekly 8 --keep-monthly 6 --prune --quiet \
  || fail "restic forget/prune failed"

# Sundays: read back 5% of the stored data to prove it is restorable.
if [ "$(date +%u)" = 7 ]; then
  restic check --read-data-subset=5% --quiet || fail "restic check found a problem"
fi

rm -rf "$STAGE"
# "latest" names the newest snapshot whatever its path list (--latest 1 lists one per path list).
SNAP=$(restic snapshots latest --compact 2>/dev/null | awk 'NR==3{print $1}')
[ -n "$SNAP" ] || SNAP=latest
FREE=$(df -h --output=avail /mnt/data | tail -1 | tr -d ' ')

# Off-site: copy every snapshot Miami does not have yet, then apply the same retention there.
# The local snapshot is already safe at this point; a failure here is reported as its own alert.
restic -r "$OFFSITE" copy --from-repo "$RESTIC_REPOSITORY" --from-password-file "$RESTIC_PASSWORD_FILE" --quiet \
  || fail "local snapshot $SNAP saved, but the copy to Miami failed"
restic -r "$OFFSITE" forget --keep-daily 14 --keep-weekly 8 --keep-monthly 6 --prune --quiet \
  || fail "local snapshot $SNAP saved and copied, but forget/prune on Miami failed"
if [ "$(date +%u)" = 7 ]; then
  restic -r "$OFFSITE" check --quiet || fail "restic check found a problem in the Miami repository"
fi

notify "G7 backup ok" "Snapshot $SNAP saved and copied to Miami. Backup disk free: $FREE." low
echo "g7-backup: snapshot $SNAP saved and copied to Miami; $FREE free on /mnt/data"
